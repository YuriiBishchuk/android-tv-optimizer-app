<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TvOptimizer.App</RootNamespace>
    <ApplicationId>com.optimizer.tv</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Pairing/TLS pairing code не потрібен: pairing робиться на ТВ вручну,
         ми підключаємось до ADB-порту (TCP/TLS). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TvOptimizer.Core\TvOptimizer.Core.csproj" />
    <ProjectReference Include="..\TvOptimizer.Transport\TvOptimizer.Transport.csproj" />
  </ItemGroup>

</Project>
